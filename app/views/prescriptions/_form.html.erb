<%= form_with(model: prescription, class: "contents") do |form| %>
  <% if prescription.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(prescription.errors.count, "error") %> prohibited this prescription from being saved:</h2>

      <ul class="list-disc ml-6">
        <% prescription.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :medicine_name %>
    <%= form.text_field :medicine_name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": prescription.errors[:medicine_name].none?, "border-red-400 focus:outline-red-600": prescription.errors[:medicine_name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :notes %>
    <%= form.textarea :notes, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": prescription.errors[:notes].none?, "border-red-400 focus:outline-red-600": prescription.errors[:notes].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :next_delivery_date %>
    <%= form.date_field :next_delivery_date, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": prescription.errors[:next_delivery_date].none?, "border-red-400 focus:outline-red-600": prescription.errors[:next_delivery_date].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :customer_id %>
    <%= form.select :customer_id,
                    options_from_collection_for_select(Customer.order(:name), :id, :name, prescription.customer_id),
                    { prompt: "Select customer" },
                    class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full bg-white", {"border-gray-400 focus:outline-blue-600": prescription.errors[:customer_id].none?, "border-red-400 focus:outline-red-600": prescription.errors[:customer_id].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
