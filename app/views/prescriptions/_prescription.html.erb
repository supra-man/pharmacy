<div id="<%= dom_id prescription %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Medicine name:</strong>
    <%= prescription.medicine_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Notes:</strong>
    <%= prescription.notes %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Next delivery date:</strong>
    <%= prescription.next_delivery_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Customer:</strong>
    <%= prescription.customer_id %>
  </div>
</div>
